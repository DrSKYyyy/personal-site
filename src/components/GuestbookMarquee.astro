---
const { apiEndpoint = '' } = Astro.props;
---

<section class="guestbook" id="guestbook">
  <div class="guestbook-header">
    <h2 class="section-title" style="margin-bottom:0.5rem">📝 留个脚印</h2>
    <p class="guestbook-subtitle">匿名留言，即刻在滚动栏中展示</p>
  </div>

  <div class="marquee-wrapper">
    <div class="marquee-fade left"></div>
    <div class="marquee-fade right"></div>

    <div class="marquee-track" id="track1"></div>
    <div class="marquee-track marquee-reverse" id="track2"></div>

    <div class="marquee-empty" id="empty-state">
      <span class="empty-icon">💬</span>
      <span class="empty-text">还没有留言，快来写下第一句话吧~</span>
    </div>
  </div>

  <div class="guestbook-form" id="form-wrapper" data-api={apiEndpoint}>
    <div class="name-row">
      <button class="name-toggle" id="nameToggle">✏️ 留下姓名</button>
      <div class="name-field hidden" id="nameField">
        <input type="text" id="nameInput" placeholder="输入你的名字..." maxlength="20" />
        <button class="name-confirm" id="nameConfirm">确定</button>
      </div>
      <span class="name-badge hidden" id="nameBadge"></span>
      <span class="name-hint" id="nameHint">匿名</span>
    </div>

    <form id="msgForm">
      <textarea id="msgInput" class="msg-input" placeholder="写下你想说的话..." maxlength="500" required></textarea>
      <button type="submit" class="btn-send" id="btnSend">发送 💬</button>
    </form>
    <div class="form-status" id="formStatus"></div>
  </div>
</section>

<script is:inline>
(function () {
  var apiUrl = (document.getElementById('form-wrapper') || {}).getAttribute('data-api') || '';
  var userName = '';
  var messages = [];

  var track1 = document.getElementById('track1');
  var track2 = document.getElementById('track2');
  var emptyEl = document.getElementById('empty-state');
  var nameToggle = document.getElementById('nameToggle');
  var nameField = document.getElementById('nameField');
  var nameInput = document.getElementById('nameInput');
  var nameConfirm = document.getElementById('nameConfirm');
  var nameBadge = document.getElementById('nameBadge');
  var nameHint = document.getElementById('nameHint');
  var msgForm = document.getElementById('msgForm');
  var msgInput = document.getElementById('msgInput');
  var btnSend = document.getElementById('btnSend');
  var formStatus = document.getElementById('formStatus');

  var savedName = '';
  try { savedName = localStorage.getItem('guestbook_name') || ''; } catch (e) {}
  if (savedName) {
    userName = savedName;
    nameToggle.textContent = '✏️ 换名字';
    nameBadge.textContent = '👤 ' + savedName;
    nameBadge.classList.remove('hidden');
    nameHint.textContent = '已署名';
    nameHint.style.color = 'var(--color-primary)';
  }

  function status(msg, err) {
    formStatus.textContent = msg;
    formStatus.className = 'form-status' + (err ? ' error' : ' ok');
    if (!err) setTimeout(function () { formStatus.className = 'form-status'; }, 3000);
  }

  function esc(s) {
    var d = document.createElement('div');
    d.textContent = s;
    return d.innerHTML;
  }

  function buildCard(m) {
    var initial = (m.name && m.name !== '匿名') ? m.name.charAt(0) : '?';
    return '<div class="msg-card">' +
      '<div class="msg-avatar">' + esc(initial) + '</div>' +
      '<div class="msg-body">' +
        '<div class="msg-name">' + esc(m.name || '匿名') + '</div>' +
        '<div class="msg-text">' + esc(m.message) + '</div>' +
      '</div>' +
    '</div>';
  }

  function buildGroup(list) {
    return list.map(buildCard).join('');
  }

  function render(msgs) {
    if (!msgs || msgs.length === 0) {
      track1.innerHTML = '';
      track2.innerHTML = '';
      emptyEl.classList.remove('hidden');
      return;
    }
    emptyEl.classList.add('hidden');

    var row1 = [], row2 = [];
    msgs.forEach(function (m, i) {
      if (i % 2 === 0) row1.push(m); else row2.push(m);
    });

    var html1 = '', html2 = '';
    for (var r = 0; r < 4; r++) {
      html1 += '<div class="msg-group">' + buildGroup(row1.length ? row1 : [{ name: '✨', message: '等你留言' }]) + '</div>';
      html2 += '<div class="msg-group">' + buildGroup(row2.length ? row2 : [{ name: '✨', message: '等你留言' }]) + '</div>';
    }
    track1.innerHTML = html1;
    track2.innerHTML = html2;
  }

  function fetchMessages() {
    var xhr = new XMLHttpRequest();
    xhr.open('GET', apiUrl + '/api/messages', true);
    xhr.onload = function () {
      if (xhr.status === 200) {
        try {
          var resp = JSON.parse(xhr.responseText);
          if (resp.ok && Array.isArray(resp.messages)) {
            messages = resp.messages;
            render(messages);
          }
        } catch (e) {}
      }
    };
    xhr.send();
  }

  nameToggle.addEventListener('click', function () {
    if (nameField.classList.contains('hidden')) {
      nameToggle.textContent = '❌ 匿名发送';
      nameField.classList.remove('hidden');
      nameInput.focus();
    } else {
      nameToggle.textContent = '✏️ 留下姓名';
      nameField.classList.add('hidden');
      nameInput.value = '';
      userName = '';
      savedName = '';
      try { localStorage.removeItem('guestbook_name'); } catch (e) {}
      nameBadge.classList.add('hidden');
      nameHint.textContent = '匿名';
      nameHint.style.color = '';
    }
  });

  nameConfirm.addEventListener('click', function () {
    var val = nameInput.value.trim();
    if (!val) { nameInput.focus(); return; }
    userName = val;
    savedName = val;
    try { localStorage.setItem('guestbook_name', val); } catch (e) {}
    nameField.classList.add('hidden');
    nameToggle.textContent = '✏️ 换名字';
    nameBadge.textContent = '👤 ' + val;
    nameBadge.classList.remove('hidden');
    nameHint.textContent = '已署名';
    nameHint.style.color = 'var(--color-primary)';
  });

  nameInput.addEventListener('keydown', function (e) {
    if (e.key === 'Enter') { e.preventDefault(); nameConfirm.click(); }
  });

  nameBadge.addEventListener('click', function () {
    nameToggle.textContent = '❌ 匿名发送';
    nameField.classList.remove('hidden');
    nameInput.value = userName;
    nameInput.focus();
    nameInput.setSelectionRange(nameInput.value.length, nameInput.value.length);
  });

  msgForm.addEventListener('submit', function (e) {
    e.preventDefault();
    var text = msgInput.value.trim();
    if (!text) { status('请写下你想说的话', true); return; }

    btnSend.disabled = true;
    btnSend.textContent = '⏳ 发送中...';

    var params = 'name=' + encodeURIComponent(savedName || '匿名') + '&message=' + encodeURIComponent(text);
    var xhr = new XMLHttpRequest();
    xhr.open('POST', apiUrl + '/api/messages', true);
    xhr.setRequestHeader('Content-Type', 'application/x-www-form-urlencoded');
    xhr.onload = function () {
      btnSend.disabled = false;
      btnSend.textContent = '发送 💬';
      if (xhr.status === 200) {
        try {
          var resp = JSON.parse(xhr.responseText);
          if (resp.ok && resp.message) {
            messages.unshift(resp.message);
            render(messages);
            msgInput.value = '';
            status('✅ 留言已发送！', false);
          } else {
            status('❌ 发送失败，请重试', true);
          }
        } catch (e) {
          status('❌ 发送失败，请重试', true);
        }
      } else {
        status('❌ 服务器错误，请稍后重试', true);
      }
    };
    xhr.onerror = function () {
      btnSend.disabled = false;
      btnSend.textContent = '发送 💬';
      status('❌ 网络错误，请检查连接', true);
    };
    xhr.send(params);
  });

  msgInput.addEventListener('keydown', function (e) {
    if ((e.ctrlKey || e.metaKey) && e.key === 'Enter') {
      e.preventDefault();
      msgForm.dispatchEvent(new Event('submit'));
    }
  });

  fetchMessages();
})();
</script>

<style>
  .guestbook-header {
    text-align: center;
    margin-bottom: 2rem;
  }

  .guestbook-subtitle {
    font-size: 0.85rem;
    color: var(--color-text-secondary);
  }

  /* ============================================
     Marquee — extracted from Magic UI pattern
     ============================================ */
  .marquee-wrapper {
    position: relative;
    width: 100%;
    overflow: hidden;
    --gap: 1rem;
    --duration: 40s;
    min-height: 130px;
  }

  .marquee-fade {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 80px;
    z-index: 2;
    pointer-events: none;
  }

  .marquee-fade.left {
    left: 0;
    background: linear-gradient(to right, var(--color-bg) 0%, transparent 100%);
  }

  .marquee-fade.right {
    right: 0;
    background: linear-gradient(to left, var(--color-bg) 0%, transparent 100%);
  }

  .marquee-track {
    display: flex;
    overflow: hidden;
    padding: 0.5rem 0;
    gap: var(--gap);
  }

  .marquee-track + .marquee-track {
    margin-top: 0.5rem;
  }

  .msg-group {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    gap: var(--gap);
    animation: marquee-scroll var(--duration) linear infinite;
  }

  .marquee-reverse .msg-group {
    animation-direction: reverse;
  }

  .marquee-track:hover .msg-group {
    animation-play-state: paused;
  }

  @keyframes marquee-scroll {
    from { transform: translateX(0); }
    to { transform: translateX(calc(-100% - var(--gap))); }
  }

  /* ============================================
     Message Card — inspired by Magic UI demo
     ============================================ */
  .msg-card {
    width: 16rem;
    flex-shrink: 0;
    border-radius: 12px;
    border: 1px solid var(--color-border);
    padding: 0.85rem 1rem;
    background: var(--color-surface);
    box-shadow: var(--shadow-sm);
    transition: box-shadow var(--transition-fast);
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    cursor: default;
  }

  .msg-card:hover {
    box-shadow: var(--shadow-md);
  }

  .msg-avatar {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--color-gradient);
    color: white;
    font-size: 0.8rem;
    font-weight: 600;
    font-family: var(--font-heading);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .msg-body {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .msg-name {
    font-size: 0.8rem;
    font-weight: 600;
    font-family: var(--font-heading);
    color: var(--color-primary);
    line-height: 1.3;
  }

  .msg-text {
    font-size: 0.85rem;
    color: var(--color-text);
    line-height: 1.4;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* ============================================
     Empty state
     ============================================ */
  .marquee-empty {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    color: var(--color-text-secondary);
    font-size: 0.9rem;
    font-family: var(--font-heading);
    pointer-events: none;
  }

  .empty-icon {
    font-size: 1.8rem;
  }

  .hidden {
    display: none !important;
  }

  /* ============================================
     Form
     ============================================ */
  .guestbook-form {
    margin-top: 1rem;
    padding: 1.5rem;
    background: var(--color-surface);
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-border);
    box-shadow: var(--shadow-sm);
  }

  .name-row {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 0.85rem;
    min-height: 36px;
    flex-wrap: wrap;
  }

  .name-toggle {
    padding: 0.4rem 1rem;
    border-radius: var(--radius-xl);
    border: 2px dashed var(--color-border);
    background: transparent;
    color: var(--color-text-secondary);
    font-family: var(--font-heading);
    font-size: 0.82rem;
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .name-toggle:hover {
    border-color: var(--color-primary);
    color: var(--color-primary);
    background: rgba(93, 173, 226, 0.06);
  }

  .name-field {
    display: flex;
    gap: 0.4rem;
    align-items: center;
  }

  .name-field input {
    padding: 0.4rem 0.7rem;
    border-radius: var(--radius-sm);
    border: 2px solid var(--color-border);
    font-family: var(--font-body);
    font-size: 0.85rem;
    color: var(--color-text);
    background: var(--color-bg);
    outline: none;
    width: 140px;
    transition: border-color var(--transition-fast);
  }

  .name-field input:focus {
    border-color: var(--color-primary);
  }

  .name-confirm {
    padding: 0.4rem 0.8rem;
    border-radius: var(--radius-sm);
    border: none;
    background: var(--color-gradient);
    color: white;
    font-family: var(--font-heading);
    font-size: 0.8rem;
    cursor: pointer;
    transition: opacity var(--transition-fast);
  }

  .name-confirm:hover {
    opacity: 0.85;
  }

  .name-badge {
    font-size: 0.88rem;
    color: var(--color-primary);
    font-family: var(--font-heading);
    padding: 0.3rem 0.8rem;
    background: rgba(93, 173, 226, 0.08);
    border-radius: var(--radius-xl);
    cursor: pointer;
    transition: background var(--transition-fast);
  }

  .name-badge:hover {
    background: rgba(93, 173, 226, 0.15);
  }

  .name-hint {
    font-size: 0.78rem;
    color: var(--color-text-secondary);
    font-family: var(--font-body);
  }

  #msgForm {
    display: flex;
    gap: 0.6rem;
    align-items: stretch;
  }

  .msg-input {
    flex: 1;
    padding: 0.6rem 0.9rem;
    border-radius: var(--radius-sm);
    border: 2px solid var(--color-border);
    font-family: var(--font-body);
    font-size: 0.88rem;
    color: var(--color-text);
    background: var(--color-bg);
    outline: none;
    resize: none;
    min-height: 44px;
    transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
  }

  .msg-input:focus {
    border-color: var(--color-primary);
    box-shadow: 0 0 0 3px rgba(93, 173, 226, 0.12);
  }

  .btn-send {
    padding: 0.6rem 1.2rem;
    border-radius: var(--radius-xl);
    border: none;
    background: var(--color-gradient);
    color: white;
    font-family: var(--font-heading);
    font-size: 0.88rem;
    cursor: pointer;
    white-space: nowrap;
    transition: all var(--transition-fast);
    align-self: stretch;
  }

  .btn-send:hover {
    transform: scale(1.03);
    box-shadow: 0 3px 12px rgba(93, 173, 226, 0.3);
  }

  .btn-send:disabled {
    opacity: 0.6;
    cursor: not-allowed;
    transform: none;
    box-shadow: none;
  }

  .form-status {
    font-size: 0.82rem;
    margin-top: 0.6rem;
    min-height: 1.2em;
    transition: opacity var(--transition-fast);
  }

  .form-status.ok {
    color: #27ae60;
  }

  .form-status.error {
    color: #e74c3c;
  }

  @media (max-width: 768px) {
    #msgForm {
      flex-direction: column;
    }

    .btn-send {
      align-self: flex-end;
    }

    .marquee-fade {
      width: 30px;
    }

    .msg-card {
      width: 12rem;
    }
  }
</style>
