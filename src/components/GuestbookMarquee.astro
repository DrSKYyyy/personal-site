---
const { apiEndpoint = '' } = Astro.props;
---

<section class="guestbook" id="guestbook">
  <p class="guestbook-subtitle">匿名留言，即刻在滚动栏中展示</p>

  <div class="marquee-wrapper-full">
    <div class="marquee-wrapper">
    <div class="marquee-fade left"></div>
    <div class="marquee-fade right"></div>

    <div class="marquee-track" id="track1"></div>
    <div class="marquee-track marquee-reverse" id="track2"></div>

    <div class="marquee-empty" id="empty-state">
      <span class="empty-icon">💬</span>
      <span class="empty-text">还没有留言，快来写下第一句话吧~</span>
    </div>
    </div>
  </div>

  <div class="form-card" id="form-wrapper" data-api={apiEndpoint}>
    <div class="name-row">
      <button class="name-toggle" id="nameToggle">✏️ 留下姓名</button>
      <div class="name-field hidden" id="nameField">
        <input type="text" id="nameInput" placeholder="输入你的名字..." maxlength="20" />
        <button class="name-confirm" id="nameConfirm">确定</button>
      </div>
      <span class="name-badge hidden" id="nameBadge"></span>
      <span class="name-hint" id="nameHint">匿名</span>
    </div>

    <form id="msgForm">
      <div class="input-wrap">
        <textarea id="msgInput" class="msg-input" placeholder="写下你想说的话..." maxlength="500" required></textarea>
        <button type="submit" class="btn-send" id="btnSend">发送</button>
      </div>
    </form>
    <div class="form-status" id="formStatus"></div>
  </div>
</section>

<script is:inline>
(function () {
  var apiUrl = (document.getElementById('form-wrapper') || {}).getAttribute('data-api') || '';
  var userName = '';
  var messages = [];

  var track1 = document.getElementById('track1');
  var track2 = document.getElementById('track2');
  var emptyEl = document.getElementById('empty-state');
  var nameToggle = document.getElementById('nameToggle');
  var nameField = document.getElementById('nameField');
  var nameInput = document.getElementById('nameInput');
  var nameConfirm = document.getElementById('nameConfirm');
  var nameBadge = document.getElementById('nameBadge');
  var nameHint = document.getElementById('nameHint');
  var msgForm = document.getElementById('msgForm');
  var msgInput = document.getElementById('msgInput');
  var btnSend = document.getElementById('btnSend');
  var formStatus = document.getElementById('formStatus');

  var savedName = '';
  try { savedName = localStorage.getItem('guestbook_name') || ''; } catch (e) {}
  if (savedName) {
    userName = savedName;
    nameToggle.textContent = '✏️ 换名字';
    nameBadge.textContent = '👤 ' + savedName;
    nameBadge.classList.remove('hidden');
    nameHint.textContent = '已署名';
    nameHint.style.color = 'var(--color-primary)';
  }

  function status(msg, err) {
    formStatus.textContent = msg;
    formStatus.className = 'form-status' + (err ? ' error' : ' ok');
    if (!err) setTimeout(function () { formStatus.className = 'form-status'; }, 3000);
  }

  function esc(s) {
    var d = document.createElement('div');
    d.textContent = s;
    return d.innerHTML;
  }

  function fmtRelative(ts) {
    if (!ts) return '';
    var d = new Date(ts);
    var now = new Date();
    var diff = now - d;
    if (diff < 60000) return '刚刚';
    if (diff < 3600000) return Math.floor(diff / 60000) + '分钟前';
    if (diff < 86400000) return Math.floor(diff / 3600000) + '小时前';
    if (diff < 172800000) return '昨天';
    var y = d.getFullYear();
    var m = String(d.getMonth() + 1).padStart(2, '0');
    var day = String(d.getDate()).padStart(2, '0');
    if (y === now.getFullYear()) return m + '月' + day + '日';
    return y + '-' + m + '-' + day;
  }

  function fmtFull(ts) {
    if (!ts) return '';
    var d = new Date(ts);
    var y = d.getFullYear();
    var m = String(d.getMonth() + 1).padStart(2, '0');
    var day = String(d.getDate()).padStart(2, '0');
    var h = String(d.getHours()).padStart(2, '0');
    var min = String(d.getMinutes()).padStart(2, '0');
    return y + '-' + m + '-' + day + ' ' + h + ':' + min;
  }

  function buildCard(m) {
    var isAnon = !m.name || m.name === '匿名';
    var displayName = esc(isAnon ? '匿名' : m.name);
    var relStr = fmtRelative(m.timestamp);
    var fullStr = fmtFull(m.timestamp);

    var avatarHtml;
    if (isAnon) {
      avatarHtml = '<div class="msg-avatar msg-avatar-anon">' +
        '<svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/></svg>' +
      '</div>';
    } else {
      var initial = m.name.charAt(0);
      avatarHtml = '<div class="msg-avatar">' + esc(initial) + '</div>';
    }

    return '<div class="msg-card">' +
      avatarHtml +
      '<div class="msg-body">' +
        '<div class="msg-top">' +
          '<span class="msg-name">' + displayName + '</span>' +
          '<span class="msg-rel">' + relStr + '</span>' +
        '</div>' +
        '<div class="msg-full-date">' + fullStr + '</div>' +
        '<div class="msg-text">' + esc(m.message) + '</div>' +
      '</div>' +
    '</div>';
  }

  function buildGroup(list) {
    return list.map(buildCard).join('');
  }

  function render(msgs) {
    if (!msgs || msgs.length === 0) {
      track1.innerHTML = '';
      track2.innerHTML = '';
      emptyEl.classList.remove('hidden');
      return;
    }
    emptyEl.classList.add('hidden');

    var row1 = [], row2 = [];
    msgs.forEach(function (m, i) {
      if (i % 2 === 0) row1.push(m); else row2.push(m);
    });

    var html1 = '', html2 = '';
    for (var r = 0; r < 4; r++) {
      html1 += '<div class="msg-group">' + buildGroup(row1) + '</div>';
      html2 += '<div class="msg-group">' + buildGroup(row2) + '</div>';
    }
    track1.innerHTML = html1;
    track2.innerHTML = html2;
  }

  function fetchMessages() {
    var xhr = new XMLHttpRequest();
    xhr.open('GET', apiUrl + '/api/messages', true);
    xhr.onload = function () {
      if (xhr.status === 200) {
        try {
          var resp = JSON.parse(xhr.responseText);
          if (resp.ok && Array.isArray(resp.messages)) {
            messages = resp.messages;
            render(messages);
          }
        } catch (e) {}
      }
    };
    xhr.send();
  }

  function resolveName() {
    if (savedName) return savedName;
    var val = nameInput.value.trim();
    if (val) return val;
    return '匿名';
  }

  nameToggle.addEventListener('click', function () {
    if (nameField.classList.contains('hidden')) {
      nameToggle.textContent = '❌ 匿名发送';
      nameField.classList.remove('hidden');
      nameInput.focus();
    } else {
      nameToggle.textContent = '✏️ 留下姓名';
      nameField.classList.add('hidden');
      nameInput.value = '';
      userName = '';
      savedName = '';
      try { localStorage.removeItem('guestbook_name'); } catch (e) {}
      nameBadge.classList.add('hidden');
      nameHint.textContent = '匿名';
      nameHint.style.color = '';
    }
  });

  nameConfirm.addEventListener('click', function () {
    var val = nameInput.value.trim();
    if (!val) { nameInput.focus(); return; }
    userName = val;
    savedName = val;
    try { localStorage.setItem('guestbook_name', val); } catch (e) {}
    nameField.classList.add('hidden');
    nameToggle.textContent = '✏️ 换名字';
    nameBadge.textContent = '👤 ' + val;
    nameBadge.classList.remove('hidden');
    nameHint.textContent = '已署名';
    nameHint.style.color = 'var(--color-primary)';
  });

  nameInput.addEventListener('keydown', function (e) {
    if (e.key === 'Enter') { e.preventDefault(); nameConfirm.click(); }
  });

  nameBadge.addEventListener('click', function () {
    nameToggle.textContent = '❌ 匿名发送';
    nameField.classList.remove('hidden');
    nameInput.value = userName;
    nameInput.focus();
    nameInput.setSelectionRange(nameInput.value.length, nameInput.value.length);
  });

  msgForm.addEventListener('submit', function (e) {
    e.preventDefault();
    var text = msgInput.value.trim();
    if (!text) { status('请写下你想说的话', true); return; }

    var finalName = resolveName();

    btnSend.disabled = true;
    btnSend.textContent = '发送中...';

    var params = 'name=' + encodeURIComponent(finalName) + '&message=' + encodeURIComponent(text);
    var xhr = new XMLHttpRequest();
    xhr.open('POST', apiUrl + '/api/messages', true);
    xhr.setRequestHeader('Content-Type', 'application/x-www-form-urlencoded');
    xhr.onload = function () {
      btnSend.disabled = false;
      btnSend.textContent = '发送';
      if (xhr.status === 200) {
        try {
          var resp = JSON.parse(xhr.responseText);
          if (resp.ok && resp.message) {
            messages.unshift(resp.message);
            render(messages);
            msgInput.value = '';
            status('✅ 留言已发送！', false);
          } else {
            status('❌ 发送失败，请重试', true);
          }
        } catch (e) {
          status('❌ 发送失败，请重试', true);
        }
      } else {
        status('❌ 服务器错误，请稍后重试', true);
      }
    };
    xhr.onerror = function () {
      btnSend.disabled = false;
      btnSend.textContent = '发送';
      status('❌ 网络错误，请检查连接', true);
    };
    xhr.send(params);
  });

  msgInput.addEventListener('keydown', function (e) {
    if ((e.ctrlKey || e.metaKey) && e.key === 'Enter') {
      e.preventDefault();
      msgForm.dispatchEvent(new Event('submit'));
    }
  });

  fetchMessages();
})();
</script>

<style is:global>
  .guestbook-subtitle {
    text-align: center;
    font-size: 0.85rem;
    color: var(--color-text-secondary);
    margin-bottom: 1rem;
  }

  /* ============================================
     Marquee Full-Width
     ============================================ */
  .marquee-wrapper-full {
    width: 100vw;
    margin-left: calc(-50vw + 50%);
    overflow: hidden;
    padding: 0;
  }

  /* ============================================
     Marquee
     ============================================ */
  .marquee-wrapper {
    position: relative;
    width: 100%;
    overflow: hidden;
    --gap: 1rem;
    --duration: 50s;
    min-height: 220px;
    padding: 0 1.5rem;
  }

  .marquee-fade {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 80px;
    z-index: 2;
    pointer-events: none;
  }

  .marquee-fade.left {
    left: 0;
    background: linear-gradient(to right, var(--color-bg) 0%, transparent 100%);
  }

  .marquee-fade.right {
    right: 0;
    background: linear-gradient(to left, var(--color-bg) 0%, transparent 100%);
  }

  .marquee-track {
    display: flex;
    overflow: hidden;
    padding: 0.5rem 0;
    gap: var(--gap);
  }

  .marquee-track + .marquee-track {
    margin-top: 0.75rem;
  }

  .msg-group {
    flex-shrink: 0;
    display: flex;
    align-items: stretch;
    gap: var(--gap);
    animation: marquee-scroll var(--duration) linear infinite;
  }

  .marquee-reverse .msg-group {
    animation-direction: reverse;
  }

  .marquee-track:hover .msg-group {
    animation-play-state: paused;
  }

  @keyframes marquee-scroll {
    from { transform: translateX(0); }
    to { transform: translateX(calc(-100% - var(--gap))); }
  }

  /* ============================================
     Message Card — taller, with date
     ============================================ */
  .msg-card {
    width: 16rem;
    flex-shrink: 0;
    border-radius: 12px;
    border: 1px solid var(--color-border);
    padding: 1rem 1.1rem;
    background: var(--color-surface);
    box-shadow: 0 1px 3px var(--color-card-shadow);
    transition: box-shadow var(--transition-fast), transform var(--transition-fast);
    display: flex;
    gap: 0.75rem;
    cursor: default;
    min-height: 100px;
  }

  .msg-card:hover {
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }

  .msg-avatar {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: var(--color-gradient);
    color: white;
    font-size: 0.9rem;
    font-weight: 600;
    font-family: var(--font-heading);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .msg-avatar-anon {
    background: #3a3a3e;
    color: rgba(255,255,255,0.5);
  }

  .msg-avatar-anon svg {
    width: 20px;
    height: 20px;
  }

  .msg-body {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .msg-top {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .msg-name {
    font-size: 0.82rem;
    font-weight: 600;
    font-family: var(--font-heading);
    color: var(--color-primary);
    line-height: 1.3;
  }

  .msg-rel {
    font-size: 0.7rem;
    color: var(--color-text-secondary);
    font-family: var(--font-body);
    opacity: 0.7;
    margin-left: auto;
  }

  .msg-full-date {
    font-size: 0.65rem;
    color: var(--color-text-secondary);
    font-family: var(--font-body);
    opacity: 0.5;
    line-height: 1.2;
  }

  .msg-text {
    font-size: 0.85rem;
    color: var(--color-text);
    line-height: 1.5;
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
  }

  /* ============================================
     Empty state
     ============================================ */
  .marquee-empty {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    color: var(--color-text-secondary);
    font-size: 0.9rem;
    font-family: var(--font-heading);
    pointer-events: none;
  }

  .empty-icon {
    font-size: 1.8rem;
  }

  .hidden {
    display: none !important;
  }

  /* ============================================
     Form Card — refined
     ============================================ */
  .form-card {
    margin-top: 1.5rem;
    padding: 1.5rem 1.8rem;
    background: var(--color-surface);
    border-radius: 16px;
    border: 1px solid var(--color-border);
    box-shadow: 0 2px 12px var(--color-card-shadow);
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
  }

  .name-row {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 0.85rem;
    min-height: 36px;
    flex-wrap: wrap;
  }

  .name-toggle {
    padding: 0.35rem 1rem;
    border-radius: var(--radius-xl);
    border: 2px dashed var(--color-border);
    background: transparent;
    color: var(--color-text-secondary);
    font-family: var(--font-heading);
    font-size: 0.8rem;
    cursor: pointer;
    transition: all var(--transition-fast);
    line-height: 1.4;
  }

  .name-toggle:hover {
    border-color: var(--color-primary);
    color: var(--color-primary);
    background: rgba(93, 173, 226, 0.06);
  }

  .name-field {
    display: flex;
    gap: 0.4rem;
    align-items: center;
  }

  .name-field input {
    padding: 0.35rem 0.7rem;
    border-radius: var(--radius-sm);
    border: 2px solid var(--color-border);
    font-family: var(--font-body);
    font-size: 0.85rem;
    color: var(--color-text);
    background: var(--color-bg);
    outline: none;
    width: 140px;
    transition: border-color var(--transition-fast);
  }

  .name-field input:focus {
    border-color: var(--color-primary);
  }

  .name-confirm {
    padding: 0.35rem 0.8rem;
    border-radius: var(--radius-sm);
    border: none;
    background: var(--color-gradient);
    color: white;
    font-family: var(--font-heading);
    font-size: 0.8rem;
    cursor: pointer;
    transition: opacity var(--transition-fast);
    line-height: 1.4;
  }

  .name-confirm:hover {
    opacity: 0.85;
  }

  .name-badge {
    font-size: 0.85rem;
    color: var(--color-primary);
    font-family: var(--font-heading);
    padding: 0.25rem 0.8rem;
    background: rgba(93, 173, 226, 0.08);
    border-radius: var(--radius-xl);
    cursor: pointer;
    transition: background var(--transition-fast);
  }

  .name-badge:hover {
    background: rgba(93, 173, 226, 0.15);
  }

  .name-hint {
    font-size: 0.75rem;
    color: var(--color-text-secondary);
    font-family: var(--font-body);
  }

  .input-wrap {
    display: flex;
    gap: 0.6rem;
    align-items: stretch;
  }

  .msg-input {
    flex: 1;
    padding: 0.7rem 1rem;
    border-radius: 10px;
    border: 2px solid var(--color-border);
    font-family: var(--font-body);
    font-size: 0.88rem;
    color: var(--color-text);
    background: var(--color-bg);
    outline: none;
    resize: none;
    min-height: 48px;
    transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
  }

  .msg-input:focus {
    border-color: var(--color-primary);
    box-shadow: 0 0 0 3px rgba(93, 173, 226, 0.1);
  }

  .msg-input::placeholder {
    color: var(--color-text-secondary);
    opacity: 0.6;
  }

  .btn-send {
    padding: 0.6rem 1.4rem;
    border-radius: 10px;
    border: none;
    background: var(--color-gradient);
    color: white;
    font-family: var(--font-heading);
    font-size: 0.9rem;
    cursor: pointer;
    white-space: nowrap;
    transition: all var(--transition-fast);
    align-self: stretch;
    letter-spacing: 0.03em;
  }

  .btn-send:hover {
    transform: scale(1.03);
    box-shadow: 0 3px 12px rgba(93, 173, 226, 0.3);
  }

  .btn-send:disabled {
    opacity: 0.6;
    cursor: not-allowed;
    transform: none;
    box-shadow: none;
  }

  .form-status {
    font-size: 0.8rem;
    margin-top: 0.6rem;
    min-height: 1.2em;
    transition: opacity var(--transition-fast);
    text-align: center;
  }

  .form-status.ok {
    color: #27ae60;
  }

  .form-status.error {
    color: #e74c3c;
  }

  @media (max-width: 768px) {
    .marquee-wrapper {
      min-height: 180px;
    }

    .marquee-fade {
      width: 30px;
    }

    .msg-card {
      width: 14rem;
      padding: 0.85rem 0.9rem;
      min-height: 85px;
    }

    .msg-avatar {
      width: 32px;
      height: 32px;
      font-size: 0.8rem;
    }

    .msg-avatar-anon svg {
      width: 16px;
      height: 16px;
    }

    .form-card {
      padding: 1.2rem 1rem;
      border-radius: 12px;
      max-width: 100%;
    }

    .input-wrap {
      flex-direction: column;
    }

    .btn-send {
      align-self: flex-end;
      padding: 0.55rem 1.2rem;
    }
  }
</style>
