---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { siteConfig } from '../../data/siteData';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map(project => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
const hasPdf = !!project.data.pdf;
const pdfUrl = hasPdf ? siteConfig.base + '/projects/' + project.data.pdf : null;
---

<Layout title={project.data.title}>
  <section class="project-detail page-enter">
    <div class="container">
      <div class="project-detail-header">
        <a href={siteConfig.base + '/projects'} class="back-link">← 返回项目列表</a>
        <span class="project-category-badge">{project.data.category}</span>
      </div>
      <h1 class="project-detail-title">{project.data.title}</h1>
      {project.data.date && <p class="project-detail-date">{project.data.date}</p>}
      {project.data.tags && (
        <div class="project-detail-tags">
          {project.data.tags.map(tag => <span class="tag">{tag}</span>)}
        </div>
      )}
      {project.data.description && (
        <p class="project-detail-desc">{project.data.description}</p>
      )}
    </div>

    {hasPdf ? (
      <div class="pdf-viewer-wrapper">
        <iframe
          src={pdfUrl}
          class="pdf-viewer"
          frameborder="0"
          allowfullscreen
          title={project.data.title}
        ></iframe>
      </div>
    ) : (
      <div class="container project-detail-no-pdf">
        <p>该项目暂无 PDF 文档可查看。</p>
        {project.data.link && (
          <a href={project.data.link} target="_blank" rel="noopener noreferrer" class="btn btn-primary">
            访问项目链接 →
          </a>
        )}
      </div>
    )}
  </section>
</Layout>

<style>
  .project-detail {
    padding-top: 2rem;
    padding-bottom: 4rem;
  }

  .project-detail-header {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .back-link {
    font-size: 0.9rem;
    color: var(--color-text-secondary);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .back-link:hover {
    color: var(--color-primary);
  }

  .project-category-badge {
    font-size: 0.75rem;
    color: var(--color-primary);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    padding: 0.2rem 0.6rem;
    border: 1px solid var(--color-primary);
    border-radius: var(--radius-sm);
  }

  .project-detail-title {
    font-size: 2rem;
    margin-bottom: 0.5rem;
  }

  .project-detail-date {
    font-size: 0.85rem;
    color: var(--color-text-secondary);
    margin-bottom: 0.75rem;
  }

  .project-detail-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
    margin-bottom: 1rem;
  }

  .project-detail-desc {
    font-size: 1rem;
    color: var(--color-text-secondary);
    line-height: 1.7;
    margin-bottom: 1.5rem;
  }

  .pdf-viewer-wrapper {
    width: 100vw;
    margin-left: calc(-50vw + 50%);
    height: calc(100vh - 250px);
    min-height: 500px;
    background: #f5f5f5;
  }

  .pdf-viewer {
    width: 100%;
    height: 100%;
    border: none;
  }

  [data-theme="dark"] .pdf-viewer-wrapper {
    background: #1a1a1a;
  }

  .project-detail-no-pdf {
    text-align: center;
    padding: 4rem 1.5rem;
    color: var(--color-text-secondary);
  }

  .project-detail-no-pdf p {
    margin-bottom: 1.5rem;
    font-size: 1rem;
  }

  @media (max-width: 768px) {
    .project-detail-title {
      font-size: 1.5rem;
    }

    .pdf-viewer-wrapper {
      height: calc(100vh - 200px);
      min-height: 400px;
    }
  }
</style>
