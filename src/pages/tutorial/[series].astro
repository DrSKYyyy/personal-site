---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const allPosts = await getCollection('blog');
  const seriesMap = new Map();

  for (const post of allPosts) {
    const s = post.data.series;
    if (!s) continue;
    if (!seriesMap.has(s)) {
      seriesMap.set(s, {
        series: s,
        title: post.data.seriesTitle || s,
        posts: [],
      });
    }
    seriesMap.get(s).posts.push(post);
  }

  const paths = [];
  for (const [series, group] of seriesMap) {
    group.posts.sort((a, b) => (a.data.seriesOrder ?? 999) - (b.data.seriesOrder ?? 999));
    paths.push({
      params: { series },
      props: { group },
    });
  }
  return paths;
}

const { group } = Astro.props;
const seriesTitle = group.title;
const posts = group.posts;

// Render all posts at build time
const renderedPosts = await Promise.all(
  posts.map(async (post, i) => {
    const { Content } = await post.render();
    return {
      slug: post.slug,
      title: post.data.title,
      order: post.data.seriesOrder ?? i,
      Content,
    };
  })
);

const firstSlug = renderedPosts[0]?.slug || '';
---

<Layout title={seriesTitle}>
  <div class="tutorial-page">
    <!-- 侧边栏 -->
    <aside class="tutorial-sidebar" id="tutorial-sidebar">
      <div class="sidebar-header">
        <h2 class="sidebar-title">{seriesTitle}</h2>
        <span class="sidebar-count">{renderedPosts.length} 篇</span>
      </div>
      <nav class="sidebar-nav">
        {renderedPosts.map((p, i) => (
          <button
            class="sidebar-item"
            data-slug={p.slug}
            data-index={i}
          >
            <span class="sidebar-item-num">{i + 1}</span>
            <span class="sidebar-item-title">{p.title}</span>
          </button>
        ))}
      </nav>
    </aside>

    <!-- 主内容区 -->
    <main class="tutorial-main" id="tutorial-main">
      <div class="tutorial-content">
        {renderedPosts.map((p, i) => (
          <article
            class="tutorial-post"
            data-slug={p.slug}
            style={{ display: i === 0 ? 'block' : 'none' }}
          >
            <p.Content />
          </article>
        ))}
      </div>

      <!-- 导航按钮 -->
      <nav class="tutorial-nav">
        <button class="nav-btn prev-btn" id="prev-btn" disabled>
          ← 上一篇
        </button>
        <span class="nav-progress" id="nav-progress">1 / {renderedPosts.length}</span>
        <button class="nav-btn next-btn" id="next-btn">
          下一篇 →
        </button>
      </nav>
    </main>
  </div>

  <!-- 移动端侧边栏开关 -->
  <button class="sidebar-toggle" id="sidebar-toggle" aria-label="切换目录">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <line x1="3" y1="6" x2="21" y2="6"></line>
      <line x1="3" y1="12" x2="21" y2="12"></line>
      <line x1="3" y1="18" x2="21" y2="18"></line>
    </svg>
  </button>
</Layout>

<script is:inline>
  (function() {
    const posts = document.querySelectorAll('.tutorial-post');
    const items = document.querySelectorAll('.sidebar-item');
    const prevBtn = document.getElementById('prev-btn');
    const nextBtn = document.getElementById('next-btn');
    const navProgress = document.getElementById('nav-progress');
    const sidebar = document.getElementById('tutorial-sidebar');
    const sidebarToggle = document.getElementById('sidebar-toggle');

    let currentIndex = 0;
    const total = posts.length;

    function showPost(index) {
      if (index < 0 || index >= total) return;

      posts.forEach((p, i) => {
        p.style.display = i === index ? 'block' : 'none';
      });

      items.forEach((item, i) => {
        item.classList.toggle('active', i === index);
        // 滚动到可见区域
        if (i === index) {
          item.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
        }
      });

      prevBtn.disabled = index === 0;
      nextBtn.disabled = index === total - 1;
      navProgress.textContent = (index + 1) + ' / ' + total;
      currentIndex = index;

      // 移动端自动收起侧边栏
      if (window.innerWidth <= 768 && sidebar) {
        sidebar.classList.remove('open');
      }
    }

    // 侧边栏点击
    items.forEach((item) => {
      item.addEventListener('click', function() {
        const index = parseInt(this.dataset.index, 10);
        showPost(index);
      });
    });

    // 上下篇按钮
    if (prevBtn) {
      prevBtn.addEventListener('click', function() {
        showPost(currentIndex - 1);
      });
    }
    if (nextBtn) {
      nextBtn.addEventListener('click', function() {
        showPost(currentIndex + 1);
      });
    }

    // 键盘快捷键
    document.addEventListener('keydown', function(e) {
      if (!sidebarToggle || sidebarToggle.style.display === 'none') {
        // desktop - use arrow keys
        if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') {
          if (!prevBtn.disabled) { showPost(currentIndex - 1); }
        } else if (e.key === 'ArrowRight' || e.key === 'ArrowDown') {
          if (!nextBtn.disabled) { showPost(currentIndex + 1); }
        }
      }
    });

    // 移动端侧边栏开关
    if (sidebarToggle) {
      sidebarToggle.addEventListener('click', function() {
        sidebar.classList.toggle('open');
      });

      // 点击遮罩关闭
      sidebar.addEventListener('click', function(e) {
        if (e.target === sidebar && window.innerWidth <= 768) {
          sidebar.classList.remove('open');
        }
      });
    }

    // URL hash 支持
    const hash = window.location.hash.replace('#', '');
    if (hash) {
      const targetItem = document.querySelector('.sidebar-item[data-slug="' + hash + '"]');
      if (targetItem) {
        showPost(parseInt(targetItem.dataset.index, 10));
      }
    }
  })();
</script>

<style>
  .tutorial-page {
    display: flex;
    min-height: calc(100vh - var(--header-height, 60px));
    position: relative;
  }

  /* ====== 侧边栏 ====== */
  .tutorial-sidebar {
    width: 280px;
    min-width: 280px;
    border-right: 1px solid var(--color-border);
    background: var(--color-bg);
    padding: 1.5rem 0;
    position: sticky;
    top: var(--header-height, 60px);
    height: calc(100vh - var(--header-height, 60px));
    overflow-y: auto;
    z-index: 20;
    transition: transform var(--transition-normal);
  }

  .sidebar-header {
    padding: 0 1.25rem 1rem;
    border-bottom: 1px solid var(--color-border);
    margin-bottom: 0.5rem;
  }

  .sidebar-title {
    font-size: 1.1rem;
    font-weight: 700;
    margin-bottom: 0.25rem;
    color: var(--color-text);
  }

  .sidebar-count {
    font-size: 0.8rem;
    color: var(--color-text-secondary);
  }

  .sidebar-nav {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .sidebar-item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    width: 100%;
    padding: 0.7rem 1.25rem;
    border: none;
    background: none;
    text-align: left;
    cursor: pointer;
    color: var(--color-text-secondary);
    font-family: var(--font-body);
    font-size: 0.88rem;
    line-height: 1.4;
    transition: all var(--transition-fast);
    position: relative;
  }

  .sidebar-item:hover {
    background: var(--color-surface);
    color: var(--color-text);
  }

  .sidebar-item.active {
    color: var(--color-primary);
    background: rgba(93, 173, 226, 0.06);
    font-weight: 500;
  }

  .sidebar-item.active::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 3px;
    background: var(--color-primary);
    border-radius: 0 2px 2px 0;
  }

  .sidebar-item-num {
    width: 1.5rem;
    height: 1.5rem;
    border-radius: 50%;
    background: var(--color-surface);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.72rem;
    font-weight: 600;
    flex-shrink: 0;
    color: var(--color-text-secondary);
    border: 1px solid var(--color-border);
  }

  .sidebar-item.active .sidebar-item-num {
    background: var(--color-primary);
    color: white;
    border-color: var(--color-primary);
  }

  .sidebar-item-title {
    flex: 1;
  }

  /* ====== 主内容 ====== */
  .tutorial-main {
    flex: 1;
    min-width: 0;
    padding: 2rem 2.5rem 4rem;
    max-width: 800px;
    margin: 0 auto;
  }

  .tutorial-post {
    line-height: 1.9;
    font-size: 1.05rem;
  }

  .tutorial-post :global(h2) {
    margin: 2rem 0 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 2px solid var(--color-border);
  }

  .tutorial-post :global(h3) {
    margin: 1.5rem 0 0.75rem;
  }

  .tutorial-post :global(p) {
    margin-bottom: 1.25rem;
  }

  .tutorial-post :global(ul), .tutorial-post :global(ol) {
    margin: 1rem 0;
    padding-left: 1.5rem;
  }

  .tutorial-post :global(li) {
    margin-bottom: 0.5rem;
  }

  .tutorial-post :global(blockquote) {
    border-left: 4px solid var(--color-primary);
    margin: 1.5rem 0;
    padding: 1rem 1.5rem;
    background: var(--color-surface);
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
    font-style: italic;
  }

  .tutorial-post :global(code) {
    background: var(--color-surface);
    padding: 0.2rem 0.4rem;
    border-radius: 4px;
    font-size: 0.9em;
  }

  .tutorial-post :global(pre) {
    background: var(--color-surface);
    padding: 1.25rem;
    border-radius: var(--radius-md);
    overflow-x: auto;
    margin: 1.5rem 0;
    border: 1px solid var(--color-border);
  }

  .tutorial-post :global(img) {
    border-radius: var(--radius-md);
    margin: 1.5rem 0;
    max-width: 100%;
  }

  .tutorial-post :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 1.5rem 0;
    font-size: 0.95rem;
    overflow-x: auto;
    display: block;
  }

  .tutorial-post :global(th),
  .tutorial-post :global(td) {
    border: 1px solid var(--color-border);
    padding: 0.6rem 1rem;
    text-align: left;
    vertical-align: top;
  }

  .tutorial-post :global(th) {
    background: var(--color-surface);
    font-weight: 600;
  }

  .tutorial-post :global(tbody tr:nth-child(even)) {
    background: rgba(0, 0, 0, 0.02);
  }

  [data-theme="dark"] .tutorial-post :global(tbody tr:nth-child(even)) {
    background: rgba(255, 255, 255, 0.03);
  }

  /* ====== 导航按钮 ====== */
  .tutorial-nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border);
  }

  .nav-btn {
    padding: 0.6rem 1.5rem;
    border-radius: var(--radius-xl);
    border: 2px solid var(--color-border);
    background: var(--color-surface);
    color: var(--color-text);
    font-family: var(--font-heading);
    font-size: 0.9rem;
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .nav-btn:hover:not(:disabled) {
    border-color: var(--color-primary);
    color: var(--color-primary);
    transform: translateY(-1px);
  }

  .nav-btn:disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }

  .nav-progress {
    font-size: 0.85rem;
    color: var(--color-text-secondary);
    font-weight: 500;
  }

  /* ====== 移动端侧边栏开关 ====== */
  .sidebar-toggle {
    display: none;
    position: fixed;
    bottom: 1.5rem;
    right: 1.5rem;
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    border: none;
    background: var(--color-primary);
    color: white;
    cursor: pointer;
    z-index: 30;
    box-shadow: 0 4px 16px rgba(93, 173, 226, 0.4);
    align-items: center;
    justify-content: center;
    transition: transform var(--transition-fast);
  }

  .sidebar-toggle:hover {
    transform: scale(1.1);
  }

  /* ====== 响应式 ====== */
  @media (max-width: 768px) {
    .tutorial-sidebar {
      position: fixed;
      top: 0;
      left: 0;
      bottom: 0;
      height: 100vh;
      z-index: 100;
      transform: translateX(-100%);
      width: 280px;
      box-shadow: 4px 0 20px rgba(0,0,0,0.15);
    }

    .tutorial-sidebar.open {
      transform: translateX(0);
    }

    .tutorial-sidebar.open::before {
      content: '';
      position: fixed;
      inset: 0;
      background: rgba(0,0,0,0.3);
      z-index: -1;
    }

    .sidebar-toggle {
      display: flex;
    }

    .tutorial-main {
      padding: 1.5rem 1.25rem 5rem;
    }
  }

  @media (max-width: 480px) {
    .tutorial-nav {
      flex-direction: column;
      gap: 0.75rem;
    }

    .nav-btn {
      width: 100%;
      text-align: center;
    }
  }
</style>
