---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import { siteConfig } from '../data/siteData';
import TypingIntro from '../components/TypingIntro.astro';
import GuestbookMarquee from '../components/GuestbookMarquee.astro';
import AnnouncementBanner from '../components/AnnouncementBanner.astro';
import KineticText from '../components/KineticText.tsx';
import Globe from '../components/Globe.tsx';

const allPosts = await getCollection('blog');
const publicPosts = allPosts.filter(p => p.data.visibility === '公开');
const recentPosts = publicPosts
  .sort((a, b) => new Date(b.data.date) - new Date(a.data.date))
  .slice(0, 3);
const base = siteConfig.base;
---

<Layout title="首页" showAnnouncementBtn={true}>
  {siteConfig.announcement?.enabled && (
    <AnnouncementBanner
      title={siteConfig.announcement.title}
      body={siteConfig.announcement.body}
      image={siteConfig.announcement.image}
      dismissLabel={siteConfig.announcement.dismissLabel}
      base={base}
    />
  )}

  <!-- Meteors background (light mode only) -->
  <div class="meteors-container" id="meteors-bg" data-meteors="30"></div>

  <!-- Particles background (dark mode only) -->
  <canvas class="particles-canvas" id="particles-canvas"></canvas>

  <TypingIntro />
  <section class="hero">
    <div class="container hero-content page-enter">
      <div class="hero-top">
        <div class="hero-avatar" id="avatar-area">
          <div class="avatar-wrapper">
            <img src={base + siteConfig.avatar} alt="头像" class="avatar-img" id="avatar-img"
                 data-frames={siteConfig.avatarFrames || 0}
                 data-interval={siteConfig.avatarFrameInterval || 380} />
            <div class="avatar-glow"></div>
          </div>
          <div class="speech-bubble" id="speech-bubble" data-bubbles={JSON.stringify(siteConfig.hero.speechBubbles)}>{siteConfig.hero.speechBubbles[0]}</div>
        </div>
        <h1 class="hero-title" id="kinetic-title">
          <KineticText text={"Hi, I'm"} as="span" className="hero-title-en font-english" client:load />
          <KineticText text={siteConfig.hero.sloganZh} as="span" className="hero-title-zh gradient-text" client:load />
        </h1>
      </div>
      <p class="hero-subtitle">{siteConfig.hero.subSlogan}</p>
      <p class="hero-desc" set:html={siteConfig.hero.description}></p>
    </div>

    <div class="scroll-indicator">
      <span>{siteConfig.hero.scrollHint}</span>
      <div class="scroll-arrow">↓</div>
    </div>
  </section>

  <!-- Globe section with retro grid -->
  <section class="globe-section">
    <div class="retro-grid-bg">
      <div class="grid-surface"></div>
    </div>
    <div class="container globe-content page-enter">
      <Globe client:load />
    </div>
  </section>

  <section class="recent-posts container page-enter">
    <h2 class="section-title">{siteConfig.recentPosts.title}</h2>
    <div class="posts-grid">
      {recentPosts.map(post => (
        <a href={base + '/writing/' + post.slug} class="post-card card shiny-btn">
          <div class="post-card-content">
            <div class="post-date">{post.data.date}</div>
            <h3 class="post-title">{post.data.title}</h3>
            <p class="post-excerpt">{post.data.description || post.data.title}</p>
            {post.data.tags && (
              <div class="post-tags">
                {post.data.tags.slice(0, 3).map(tag => <span class="tag">{tag}</span>)}
              </div>
            )}
          </div>
        </a>
      ))}
    </div>
    <div class="view-all">
      <a href={base + '/writing'} class="btn btn-outline shiny-btn">{siteConfig.recentPosts.viewAll}</a>
    </div>
  </section>

  <section class="home-comments page-enter">
    <GuestbookMarquee apiEndpoint={siteConfig.formEndpoint} />
  </section>
</Layout>

<script is:inline>
(function() {
  var bubble = document.getElementById('speech-bubble');
  if (bubble && bubble.dataset.bubbles) {
    try {
      var texts = JSON.parse(bubble.dataset.bubbles);
      if (texts && texts.length > 1) {
        setInterval(function() {
          var idx = Math.floor(Math.random() * texts.length);
          bubble.textContent = texts[idx];
        }, 4000);
      }
    } catch(e) {}
  }

  var avatarImg = document.getElementById('avatar-img');
  if (avatarImg) {
    var totalFrames = parseInt(avatarImg.getAttribute('data-frames') || '0', 10);
    var frameInterval = parseInt(avatarImg.getAttribute('data-interval') || '380', 10);
    if (totalFrames > 1) {
      var currentFrame = 1;
      var basePath = '/images/形象/';
      var loadedImages = [];
      for (var fi = 1; fi <= totalFrames; fi++) {
        (function(idx) {
          var img = new Image();
          img.src = basePath + idx + '.png';
          loadedImages.push(img);
        })(fi);
      }
      setInterval(function() {
        currentFrame = currentFrame >= totalFrames ? 1 : currentFrame + 1;
        avatarImg.src = basePath + currentFrame + '.png';
      }, frameInterval);
    }
  }

  // Meteors generation
  var meteorsContainer = document.getElementById('meteors-bg');
  function generateMeteors() {
    if (!meteorsContainer) return;
    var count = parseInt(meteorsContainer.getAttribute('data-meteors') || '20', 10);
    var isLight = document.documentElement.getAttribute('data-theme') !== 'dark';
    meteorsContainer.innerHTML = '';
    if (!isLight) return;
    for (var mi = 0; mi < count; mi++) {
      var meteor = document.createElement('div');
      meteor.className = 'meteor';
      meteor.style.left = Math.random() * window.innerWidth + 'px';
      meteor.style.setProperty('--meteor-delay', (Math.random() * 1 + 0.2) + 's');
      meteor.style.setProperty('--meteor-duration', (Math.floor(Math.random() * 8 + 2)) + 's');
      meteor.style.setProperty('--meteor-angle', '215deg');
      meteorsContainer.appendChild(meteor);
    }
  }

  generateMeteors();
  var meteorObserver = new MutationObserver(function() {
    generateMeteors();
  });
  meteorObserver.observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
  window.addEventListener('resize', generateMeteors);

  // Particles (dark mode)
  var particlesCanvas = document.getElementById('particles-canvas');
  var particlesCtx, particlesAnimId;
  var particleList = [];
  var mouseX = -1000, mouseY = -1000;

  function initParticles() {
    if (!particlesCanvas) return;
    var isDark = document.documentElement.getAttribute('data-theme') === 'dark';
    particlesCanvas.style.display = isDark ? 'block' : 'none';
    if (!isDark) {
      if (particlesAnimId) { cancelAnimationFrame(particlesAnimId); particlesAnimId = null; }
      return;
    }
    var rect = particlesCanvas.parentElement.getBoundingClientRect();
    particlesCanvas.width = window.innerWidth;
    particlesCanvas.height = window.innerHeight;
    particlesCtx = particlesCanvas.getContext('2d');
    var count = 80;
    particleList = [];
    for (var pi = 0; pi < count; pi++) {
      particleList.push({
        x: Math.random() * particlesCanvas.width,
        y: Math.random() * particlesCanvas.height,
        vx: (Math.random() - 0.5) * 0.5,
        vy: (Math.random() - 0.5) * 0.5,
        r: Math.random() * 1.5 + 0.5,
      });
    }
    animateParticles();
  }

  function animateParticles() {
    if (!particlesCtx || !particlesCanvas) return;
    var isDark = document.documentElement.getAttribute('data-theme') === 'dark';
    if (!isDark) { particlesAnimId = null; return; }
    particlesCtx.clearRect(0, 0, particlesCanvas.width, particlesCanvas.height);
    for (var pi = 0; pi < particleList.length; pi++) {
      var p = particleList[pi];
      p.x += p.vx;
      p.y += p.vy;
      if (p.x < 0 || p.x > particlesCanvas.width) p.vx *= -1;
      if (p.y < 0 || p.y > particlesCanvas.height) p.vy *= -1;
      var dx = mouseX - p.x;
      var dy = mouseY - p.y;
      var dist = Math.sqrt(dx * dx + dy * dy);
      if (dist < 120) {
        p.vx -= dx / dist * 0.02;
        p.vy -= dy / dist * 0.02;
      }
      p.vx = Math.max(-2, Math.min(2, p.vx));
      p.vy = Math.max(-2, Math.min(2, p.vy));
      particlesCtx.beginPath();
      particlesCtx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
      particlesCtx.fillStyle = 'rgba(255, 255, 255, 0.6)';
      particlesCtx.fill();
    }
    particlesAnimId = requestAnimationFrame(animateParticles);
  }

  initParticles();
  var particleObserver = new MutationObserver(function() { initParticles(); });
  particleObserver.observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });

  document.addEventListener('mousemove', function(e) {
    mouseX = e.clientX;
    mouseY = e.clientY;
  });
  window.addEventListener('resize', function() {
    if (particlesCanvas) {
      particlesCanvas.width = window.innerWidth;
      particlesCanvas.height = window.innerHeight;
    }
  });
})();
</script>

<style>
  .hero {
    min-height: calc(100vh - var(--nav-height));
    display: flex;
    flex-direction: column;
    justify-content: center;
    position: relative;
    overflow: hidden;
  }

  .hero-content {
    text-align: center;
    max-width: 700px;
    margin: 0 auto;
    padding: 2rem 1.5rem;
  }

  .hero-top {
    margin-bottom: 1.5rem;
  }

  .hero-avatar {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  .avatar-wrapper {
    position: relative;
    width: 180px;
    height: 180px;
    animation: float 4s ease-in-out infinite;
  }

  .avatar-img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    filter: drop-shadow(0 8px 24px rgba(93, 173, 226, 0.25));
    border-radius: 50%;
  }

  .avatar-glow {
    position: absolute;
    inset: -8px;
    border-radius: 50%;
    background: var(--color-gradient);
    opacity: 0.15;
    filter: blur(16px);
    z-index: -1;
    animation: twinkle 3s ease-in-out infinite;
  }

  .speech-bubble {
    background: var(--color-surface);
    color: var(--color-text);
    padding: 0.5rem 1.2rem;
    border-radius: var(--radius-xl);
    font-size: 0.9rem;
    font-family: var(--font-heading);
    box-shadow: var(--shadow-md);
    position: relative;
    border: 1px solid var(--color-border);
    white-space: nowrap;
    transition: opacity var(--transition-normal);
    opacity: 0;
  }

  .speech-bubble::before {
    content: '';
    position: absolute;
    top: -8px;
    left: 50%;
    transform: translateX(-50%);
    border-left: 8px solid transparent;
    border-right: 8px solid transparent;
    border-bottom: 8px solid var(--color-surface);
  }

  .hero-avatar:hover .speech-bubble {
    opacity: 1;
  }

  .hero-title {
    display: flex;
    flex-direction: row;
    align-items: baseline;
    justify-content: center;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
    flex-wrap: wrap;
  }

  .hero-title-en {
    font-size: 3.5rem;
    line-height: 1.15;
    color: var(--color-text);
  }

  .hero-title-zh {
    font-size: 3.5rem;
    line-height: 1.15;
  }

  .hero-subtitle {
    font-size: 1.3rem;
    color: var(--color-primary);
    font-family: var(--font-heading);
    margin-bottom: 1rem;
  }

  .hero-desc {
    font-size: 1.05rem;
    color: var(--color-text-secondary);
    line-height: 1.8;
    margin-bottom: 1.5rem;
  }

  .scroll-indicator {
    position: absolute;
    bottom: 2rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.3rem;
    animation: float 2s ease-in-out infinite;
    color: var(--color-text-secondary);
  }

  .scroll-indicator span {
    font-size: 0.8rem;
    font-family: var(--font-heading);
  }

  .scroll-arrow {
    font-size: 1.2rem;
    animation: hintBounce 1.5s ease-in-out infinite;
  }

  @keyframes hintBounce {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(4px); }
  }

  .globe-section {
    padding: 4rem 0 6rem;
    min-height: 500px;
    display: flex;
    align-items: center;
  }

  .globe-content {
    text-align: center;
    width: 100%;
  }

  .recent-posts {
    padding: 4rem 0;
  }

  .posts-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 1.5rem;
    margin-bottom: 2rem;
  }

  .post-card {
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
    transition: transform var(--transition-normal), box-shadow var(--transition-normal);
  }

  .post-card:hover {
    text-decoration: none;
  }

  .post-card-content {
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .post-date {
    font-size: 0.8rem;
    color: var(--color-text-secondary);
    margin-bottom: 0.5rem;
  }

  .post-title {
    font-size: 1.2rem;
    margin-bottom: 0.75rem;
    transition: color var(--transition-fast);
    color: var(--color-text);
  }

  .post-card:hover .post-title {
    color: var(--color-primary);
  }

  .post-excerpt {
    font-size: 0.9rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
    flex: 1;
    margin-bottom: 0.75rem;
  }

  .post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
    margin-top: auto;
  }

  .view-all {
    text-align: center;
  }

  .home-comments {
    padding: 3rem 0 4rem;
  }

  @media (max-width: 768px) {
    .hero-content {
      padding: 1.5rem 1rem;
    }

    .hero-title-en,
    .hero-title-zh {
      font-size: 2.5rem;
    }

    .avatar-wrapper {
      width: 150px;
      height: 150px;
    }

    .posts-grid {
      grid-template-columns: 1fr;
    }

    .scroll-indicator {
      display: none;
    }

    .globe-section {
      padding: 2rem 0 4rem;
      min-height: 400px;
    }
  }
</style>
